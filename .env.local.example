# Copy to .env.local (gitignored). Loaded into process.env at boot for
# agent, CLI, eval, and web. Shell-exported vars still win if already set.

# --- LLM ---
# Options: stub | openai
# stub = offline echo of Plan + When to seek care; openai = real model
LLM_PROVIDER=stub

# Required when LLM_PROVIDER=openai (spec name: OPEN_AI_API_KEY)
OPEN_AI_API_KEY=

# Chat model id when using openai
OPENAI_MODEL=gpt-4o-mini

# Provider retries on 429/5xx (integer 1–5)
LLM_MAX_ATTEMPTS=3

# Backoff base in ms between provider retries (integer)
LLM_RETRY_BASE_MS=200

# --- Triage / grounding ---
# Quote + LLM-judge grounding. Options: 1 (on) | 0 (off)
GROUNDING_CHECK=1

# Regenerations after a grounding failure (integer 0–3)
GROUNDING_MAX_RETRIES=2

# Prompt pack. Options: v1 | v2 | v3
PROMPT_VERSION=v1

# --- Agent HTTP service ---
# Bind address / port for apps/agent
HOST=127.0.0.1
PORT=4001

# Optional label returned in responses (default: agent-<pid>)
# AGENT_INSTANCE=agent-1

# Optional override for visit-summary data directory
# (default: <repo>/take_home_starter)
# DATA_DIR=

# --- Web (apps/web) ---
# Base URL of the agent service
AGENT_SERVICE_URL=http://127.0.0.1:4001

# Fetch timeout in ms when calling the agent (integer 1–120000)
AGENT_TIMEOUT_MS=30000
